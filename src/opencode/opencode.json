{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "mkdir *": "allow",
      "source *": "allow",
      "which *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "yarn *": "allow",
      "python *": "allow",
      "bundle *": "allow",
      "gem *": "allow",
      "pip *": "allow",
      "pip3 *": "allow",
      "bin/rails *": "allow",
      "rails *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch -vv": "allow",
      "git stash list": "allow",
      "git fetch*": "allow",
      "docker ps*": "allow",
      "docker logs *": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "external_directory": {
      "*": "allow",
      "~/**": "ask",
      "~/Workspace/**": "allow"
    }
  },
  "plugin": [],
  "default_agent": "_developer",
  "shell": "zsh"
}
